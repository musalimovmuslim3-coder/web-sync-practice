                            <pre id="codeSnippet" class="overflow-x-auto pr-24 py-1 text-sky-300"><code>import { QuantumRegister, HadamardGate } from 'quantum-core';

// Создаем регистр из 4 кубитов
const register = new QuantumRegister(4);

// Применяем преобразование Адамара
register.apply(new HadamardGate(), 0);
register.entangle([0, 1]);


    <!-- Interactive Scripting -->
    <script>
        // Toggle Clone dropdown menu
        function toggleCloneDropdown() {
            const dropdown = document.getElementById('cloneDropdown');
            dropdown.classList.toggle('hidden');
        }

        // Close dropdown when clicking outside
        window.addEventListener('click', function(e) {
            const dropdown = document.getElementById('cloneDropdown');
            const button = e.target.closest('button');
            if (!dropdown.contains(e.target) && (!button || !button.textContent.includes('Code'))) {
                dropdown.classList.add('hidden');
            }
        });

        // Copy clone URL to clipboard
        function copyCloneUrl() {
            const input = document.getElementById('cloneUrlInput');
            input.select();
            input.setSelectionRange(0, 99999);
            document.execCommand('copy');
            
            const icon = document.getElementById('copyIcon');
            icon.className = "fa-solid fa-check text-emerald-400";
            setTimeout(() => {
                icon.className = "fa-regular fa-copy";
            }, 2000);
        }

        // Copy generic code snippets
        function copySnippet(btn, elementId) {
            const preElement = document.getElementById(elementId);
            const text = preElement.innerText;
            
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);

            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-check mr-1 text-emerald-400"></i> Скопировано!';
            setTimeout(() => {
                btn.innerHTML = originalHTML;
            }, 2000);
        }

        // Switch between README and Live Demo tabs
        function switchTab(tab) {
            const readmeBtn = document.getElementById('tabReadmeBtn');
            const demoBtn = document.getElementById('tabDemoBtn');
            const readmeContent = document.getElementById('readmeContent');
            const demoContent = document.getElementById('demoContent');

            if (tab === 'readme') {
                readmeBtn.className = "px-3 py-1 text-xs font-semibold rounded bg-[#30363d] text-white transition";
                demoBtn.className = "px-3 py-1 text-xs font-semibold rounded text-github-muted hover:text-white transition";
                readmeContent.classList.remove('hidden');
                demoContent.classList.add('hidden');
            } else {
                demoBtn.className = "px-3 py-1 text-xs font-semibold rounded bg-[#30363d] text-white transition";
                readmeBtn.className = "px-3 py-1 text-xs font-semibold rounded text-github-muted hover:text-white transition";
                demoContent.classList.remove('hidden');
                readmeContent.classList.add('hidden');
            }
        }

        // Interactive Quantum Simulation simulator in Demo Tab
        function runQuantumSimulation() {
            const states = [
                "|Ψ⟩ = 1.000|00⟩ + 0.000|11⟩ (Collapsed)",
                "|Ψ⟩ = 0.000|00⟩ + 1.000|11⟩ (Collapsed)",
                "|Ψ⟩ = 0.500|01⟩ + 0.866|10⟩ (Superposition)",
                "|Ψ⟩ = 0.707|00⟩ + 0.707|11⟩ (Entangled)"
            ];
            const randomState = states[Math.floor(Math.random() * states.length)];
            document.getElementById('quantumStateDisplay').innerText = randomState;
        }

        function resetQuantumSimulation() {
            document.getElementById('quantumStateDisplay').innerText = "|Ψ⟩ = 0.707|00⟩ + 0.707|11⟩";
        }

        function openAddFileDialog() {
            alert("Функция создания файлов доступна после авторизации через GitHub OAuth.");
        }

        function triggerZipDownload(e) {
            e.preventDefault();
            alert("Загрузка архива quantum-core-main.zip началась!");
        }
    </script>
